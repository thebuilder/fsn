{
  "name": "fsn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@fsn/web --cache-dir=.turbo/cache",
    "dev:web": "turbo run dev --filter=@fsn/web --cache-dir=.turbo/cache",
    "dev:desktop": "pnpm --filter=@fsn/desktop tauri:dev",
    "build": "turbo run build --cache-dir=.turbo/cache",
    "build:desktop": "pnpm --filter=@fsn/desktop tauri:build",
    "typecheck": "turbo run typecheck --cache-dir=.turbo/cache",
    "test": "turbo run test --cache-dir=.turbo/cache",
    "lint": "biome lint .",
    "check": "pnpm lint && turbo run typecheck test build --cache-dir=.turbo/cache",
    "validate:desktop-release": "node tools/validate-desktop-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "turbo": "^2.10.9"
  },
  "packageManager": "pnpm@10.14.0"
}
