{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local filesystem access explicitly selected by the user.",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:path:default",
    "dialog:allow-open",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "allow-open-native"
  ]
}
